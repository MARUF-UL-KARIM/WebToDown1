# Server configuration (Express/Node runtime; all have safe defaults)
PORT=3000
NODE_ENV=development

# Media processing & security limits (non-secret, safe defaults)
TEMP_DIR=/tmp/clipfetch_jobs
MAX_FILE_SIZE_MB=500
MAX_DURATION_SEC=3600
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SEC=600
AUTO_CLEANUP_MINUTES=15

# Optional explicit binary paths (auto-detected by default; leave blank unless overriding)
YTDLP_BIN=
FFMPEG_BIN=
FFPROBE_BIN=
NODE_BIN=

# Optional sensitive/manual overrides (never commit real cookies or proxy credentials)
# YTDLP_COOKIES_FILE: path to a Netscape cookies.txt file on the server
# YTDLP_COOKIES_B64: base64-encoded cookies.txt (useful in AI Studio / Cloud Run Secrets without shell access)
# YTDLP_PROXY: optional residential HTTP/HTTPS/SOCKS5 proxy URL for datacenter extraction
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
YTDLP_PROXY=

# YouTube-only Cobalt extraction adapter (no yt-dlp, no user cookies)
# COBALT_API_URL: optional URL to your self-hosted official Cobalt API instance (e.g. https://cobalt.example.com)
# COBALT_API_KEY: optional Api-Key header value for a protected self-hosted Cobalt API instance
# YOUTUBE_SESSION_SERVER: optional URL to imputnet/yt-session-generator for poToken & visitor_data
# COBALT_PROXY: optional HTTP/HTTPS proxy URL dedicated to YouTube Cobalt Innertube/session fetches
# CUSTOM_INNERTUBE_CLIENT: optional Innertube client override (e.g. WEB_EMBEDDED, IOS, TV)
COBALT_API_URL=
COBALT_API_KEY=
YOUTUBE_SESSION_SERVER=
COBALT_PROXY=
CUSTOM_INNERTUBE_CLIENT=

# Flask backend settings (only used when running Python/Flask backend independently)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*
